{
  "name": "learntech-content",
  "version": "1.0.0",
  "private": true,
  "description": "API de conteúdo do ecossistema LearnTECH: catálogo em JSON versionado e registro de acessos.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsx scripts/build.ts",
    "validar": "tsx scripts/build.ts --somente-validar",
    "dev": "npm run build && wrangler dev",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "verificar": "npm run typecheck && npm test && npm run build",
    "db:migrar:local": "wrangler d1 migrations apply learntech-acessos --local",
    "db:migrar:remoto": "wrangler d1 migrations apply learntech-acessos --remote",
    "deploy": "npm run build && wrangler deploy",
    "copias": "node scripts/exportar-copias.mjs",
    "copias:conferir": "node scripts/exportar-copias.mjs --conferir",
    "midia:externa": "node scripts/baixar-imagens-externas.mjs",
    "hd:inventariar": "node scripts/hd-inventariar.mjs",
    "leva:status": "node scripts/leva-status.mjs",
    "cobertura": "node scripts/cobertura-projetos.mjs",
    "progresso": "node scripts/progresso.mjs",
    "format:check": "prettier --check \"src/**/*.ts\" \"scripts/**/*.{ts,mjs}\" \"tests/**/*.ts\"",
    "lint": "eslint src scripts tests",
    "e2e": "playwright test -c e2e/playwright.config.mjs",
    "ux:lighthouse": "node scripts/ux/lighthouse.mjs",
    "ux:resumo": "node scripts/ux/resumir-e2e.mjs",
    "sitemaps": "node scripts/gerar-sitemaps.mjs",
    "auditar": "node scripts/auditar-dependencias.mjs"
  },
  "dependencies": {
    "hono": "^4.13.9",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@cloudflare/workers-types": "^5.20260927.1",
    "@eslint/js": "^9.20.0",
    "@playwright/test": "^1.56.0",
    "@types/node": "^22.0.0",
    "chrome-launcher": "^1.2.0",
    "eslint": "^9.20.0",
    "globals": "^15.15.0",
    "lighthouse": "^12.8.0",
    "prettier": "^3.5.0",
    "tsx": "^4.23.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.24.0",
    "vitest": "~4.1.11",
    "wrangler": "^4.42.0"
  }
}
