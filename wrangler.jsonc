// wrangler.jsonc — configuração do Worker learntech-content (plano gratuito da Cloudflare).
// Leitura: arquivos estáticos em ./dist (gerados por `npm run build`).
// Escrita: só /v1/acessos e /v1/mensagens (formulário "Fala aê"), que passam pelo Worker e gravam no D1.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "learntech-content",
  "main": "src/worker.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "none",
    "run_worker_first": ["/v1/acessos", "/v1/acessos/*", "/v1/mensagens", "/v1/saude"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "learntech-acessos",
      "database_id": "e6b6e8f4-a8f7-4503-b520-b798db3739e7",
      "migrations_dir": "migrations"
    }
  ],
  // Limite de taxa das escritas (POST /v1/acessos e /v1/mensagens): 30 por 60 s por IP e rota, contado em cada
  // localização da Cloudflare. Gratuito; vale a partir do próximo deploy. namespace_id é um número escolhido por nós,
  // único na conta. Ver ADR 10 em docs/DECISOES.md.
  "ratelimits": [
    { "name": "LIMITADOR_ESCRITA", "namespace_id": "1001", "simple": { "limit": 30, "period": 60 } }
  ],
  "triggers": { "crons": ["0 3 * * *"] },
  "vars": {
    "ALLOWED_ORIGINS": "https://learn-tech-pied.vercel.app,https://bootcamps-dun.vercel.app,https://douglasabnovato.github.io,http://localhost:*,http://127.0.0.1:*",
    "RETENCAO_DIAS": "365",
    "JANELA_DEDUPE_MIN": "30"
  },
  "observability": { "enabled": true }
}
// Segredos (nunca neste arquivo): `wrangler secret put ADMIN_TOKEN` e, se usar Turnstile, `wrangler secret put TURNSTILE_SECRET`.
